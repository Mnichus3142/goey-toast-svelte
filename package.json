{
    "name": "goey-toast-svelte",
    "version": "0.1.0",
    "description": "A gooey, morphing toast component for Svelte 5 built on svelte-sonner with Motion animations",
    "type": "module",
    "svelte": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "svelte": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./styles.css": "./dist/components/GooeyToast.css"
    },
    "sideEffects": [
        "*.css"
    ],
    "files": [
        "dist",
        "skills",
        "bin"
    ],
    "bin": {
        "goey-toast-svelte": "bin/cli.mjs"
    },
    "scripts": {
        "prepublishOnly": "npm run check && npm run build",
        "build": "svelte-package -i src/lib",
        "dev": "svelte-package -i src/lib --watch",
        "check": "svelte-check --tsconfig ./tsconfig.json",
        "package": "svelte-package -i src/lib",
        "typecheck": "svelte-check --tsconfig ./tsconfig.json"
    },
    "peerDependencies": {
        "motion": ">=11.0.0",
        "svelte": ">=5.0.0"
    },
    "dependencies": {
        "svelte-sonner": "^1.0.5"
    },
    "devDependencies": {
        "@sveltejs/package": "^2.5.0",
        "@sveltejs/vite-plugin-svelte": "^5.1.0",
        "@types/node": "^25.2.3",
        "motion": "^12.34.0",
        "publint": "^0.3.12",
        "svelte": "^5.38.0",
        "svelte-check": "^4.3.0",
        "typescript": "^5.9.3",
        "vite": "^6.3.5"
    },
    "keywords": [
        "toast",
        "notification",
        "svelte",
        "svelte-sonner",
        "motion",
        "animation",
        "morph"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Mnichus3142/goey-toast-svelte.git"
    },
    "homepage": "https://github.com/Mnichus3142/goey-toast-svelte#readme",
    "bugs": {
        "url": "https://github.com/Mnichus3142/goey-toast-svelte/issues"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}
